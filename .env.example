# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Optional: a long random string. If empty, one is generated into instance/secret_key.txt
SECRET_KEY=
# Set to true only when the site is served over HTTPS
SESSION_COOKIE_SECURE=false
